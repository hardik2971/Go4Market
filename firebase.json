{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log", "src", "tsconfig.json"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": [
    {
      "target": "website",
      "public": "apps/website/build/web",
      "ignore": ["firebase.json", "**/.*"],
      "cleanUrls": true,
      "rewrites": [
        { "source": "/sitemap.xml", "function": { "functionId": "sitemap", "region": "asia-south1" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "**/*.@(js|wasm|mjs|png|jpg|jpeg|webp|svg|woff2|ttf|otf|json)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|firebase-messaging-sw.js|main.dart.js|version.json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
      ]
    },
    { "target": "admin", "public": "apps/panel/build/admin", "ignore": ["**/.*"], "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [{ "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }] },
    { "target": "seller", "public": "apps/panel/build/seller", "ignore": ["**/.*"], "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [{ "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }] },
    { "target": "delivery", "public": "apps/panel/build/delivery", "ignore": ["**/.*"], "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [{ "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }] }
  ]
}
